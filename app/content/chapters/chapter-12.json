              ]
            }
          ]
        ]
      },
      {
        "id": "block-1393",
        "sourceIds": ["block-1393"],
        "kind": "paragraph",
        "content": [
          {
            "text": "ㅡㅡㅡㅡㅡㅡㅡㅡㅡㅡㅡㅡㅡ"

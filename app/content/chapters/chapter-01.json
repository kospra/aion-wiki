        "kind": "heading",
        "content": [
          {
            "text": "PANTHEON (STATS) / STATUES"
          }
        ],
        "level": 2
      },
      {
        "id": "block-0098",
        "sourceIds": ["block-0098"],
        "kind": "paragraph",
        "content": [
          {
            "text": "The Pantheon Stats are….just more stats…but bundled stats. Each Pantheon Stat gives you 2 effect stats. "
          }
        ]
      },
      {
        "id": "block-0099",
        "sourceIds": ["block-0099"],
        "kind": "figure",
        "figureId": "figure-007"
      },
      {
        "id": "block-0102",
        "sourceIds": ["block-0102"],

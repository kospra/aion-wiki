{
  "name": "aion-2-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:static": "npm run build && node scripts/prepare-static.mjs && npm run verify:static",
    "build:netlify": "npm run check && npm run build:static",
    "preview": "serve build/client",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:content": "node scripts/content-integrity.ts",
    "verify:browser": "node scripts/verify-guide-browser.mjs",
    "content:generate": "node scripts/generate-catalogue.ts",
    "content:check": "node scripts/generate-catalogue.ts --check",
    "verify:browser:all": "node scripts/run-browser-checks.mjs",
    "check": "npm run content:check && npm run verify:content && npm run lint && npm run format:check && npm run typecheck && vitest run --pool=vmThreads --maxWorkers=1",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "11.14.0",
    "isbot": "5.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "serve": "14.2.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12.1.0 <13"
  }
}

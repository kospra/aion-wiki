                {
                  "text": "Stat Lines (Soul"
                },
                {
                  "text": " Binding)"
                }
              ],
              "level": 2
            },
            {
              "id": "list-block-0061",
              "sourceIds": [],
              "kind": "list",
              "ordered": false,
              "items": [
                [
                  {
                    "id": "block-0061",
                    "sourceIds": ["block-0061"],
                    "kind": "paragraph",
                    "content": [
                      {
                        "text": "RNG stat lines rolled from a pool specific to gear piece (ex: all Helmets have the same stat pool, all Weapons have the same stat pools)"
                      }
                    ]
                  }
                ],
                [
                  {
                    "id": "block-0062",
                    "sourceIds": ["block-0062"],
                    "kind": "paragraph",
                    "content": [
                      {
                        "text": "These lines can be rerolled individually using “Synch Stones”"
                      }
                    ]
                  }
                ],
                [
                  {
                    "id": "block-0063",
                    "sourceIds": ["block-0063"],
                    "kind": "paragraph",
                    "content": [
                      {
                        "text": "These lines can be completely shuffled altogether using Orange “Soul Codex: Reset” otherwise known as “Reset Books”"
                      }
                    ]
                  }
                ],
                [
                  {
                    "id": "block-0064",
                    "sourceIds": ["block-0064"],
                    "kind": "paragraph",
                    "content": [
                      {
                        "text": "The value of each stat can be enhanced and reached higher values by using “Soul Codex” books. "
                      }
                    ]
                  }
                ],
                [
                  {
                    "id": "block-0065",
                    "sourceIds": ["block-0065"],
                    "kind": "paragraph",
                    "content": [
                      {
                        "text": "An additional Stat Line can be unlocked by using “Philosopher’s Stone” after “Soul Binding Rate” reaches 100%...in other words, once you enhance every stat to 100% using Soul Codex books in the Enhancement > Soul Binding > Bind menu"
                      }
                    ]
                  }
                ],
                [
                  {
                    "id": "block-0066",
                    "sourceIds": ["block-0066"],
                    "kind": "paragraph",
                    "content": [
                      {
                        "text": "Further Detail",
                        "strong": true,
                        "underline": true,
                        "href": "/articles/soul-binding-bind-sync-and-reset#block-0463"
                      }
                    ]
                  }
                ]
              ]
            }
          ]
